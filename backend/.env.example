# Application settings for the forest patrol backend.
FOREST_ENVIRONMENT=development
FOREST_API_HOST=127.0.0.1
FOREST_API_PORT=8000

# PostgreSQL connection used by the forest patrol database.
# Use timezone-aware UTC application datetimes.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/forest_patrol

# Dashboard origin(s) allowed to call this API (comma-separated). In
# production this MUST be set explicitly to the real dashboard URL(s) --
# it defaults to [] (nothing allowed) when FOREST_ENVIRONMENT=production
# and this is unset. See app/core/config.py.
FOREST_CORS_ORIGINS=http://localhost:3000

# MQTT broker (Gateway -> Backend event transport, see docs/MQTT.md).
# Local dev: docker compose up mosquitto (or `brew services start mosquitto`).
# Production MUST set MQTT_USERNAME/MQTT_PASSWORD and MQTT_TLS=true against
# an authenticated, TLS-enabled broker -- never point at an open broker.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
