# Backend API base URL (FastAPI server). Also used to derive the WebSocket
# URL (http(s) -> ws(s), see lib/ws.ts) -- no separate WS env var needed.
# This is a NEXT_PUBLIC_ var, so it is baked in at build time: set it to the
# real production backend URL before running `next build` for deployment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
